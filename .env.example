# UGOS API keys -- copy this file to ".env" and fill in the ones you use.
#
# The .env file stays on your machine: it is listed in .gitignore and is
# never committed. NEVER put a key in ugos_config.py, which IS committed.

# Google Gemini -- free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (very fast) -- free key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (many models, one key) -- https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Others, only if you use them
OPENAI_API_KEY=
TOGETHER_API_KEY=
