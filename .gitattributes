# Normalize line endings to LF in the repository for all text files.
* text=auto eol=lf

*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf

# Binary files should never be touched.
*.db binary
*.pyc binary
*.png binary
*.jpg binary
